import { OxideTheme } from "../theme.slint";

// Bundled Material Symbols (24dp, single path, colorized at runtime).
export global OxideIcons {
    out property <image> backspace: @image-url("../icons/backspace.svg");
    out property <image> check: @image-url("../icons/check.svg");
    out property <image> close: @image-url("../icons/close.svg");
    out property <image> dark-mode: @image-url("../icons/dark-mode.svg");
    out property <image> delete: @image-url("../icons/delete.svg");
    out property <image> expand-less: @image-url("../icons/expand-less.svg");
    out property <image> expand-more: @image-url("../icons/expand-more.svg");
    out property <image> function: @image-url("../icons/function.svg");
    out property <image> history: @image-url("../icons/history.svg");
    out property <image> light-mode: @image-url("../icons/light-mode.svg");
    out property <image> chevron-left: @image-url("../icons/chevron-left.svg");
    out property <image> chevron-right: @image-url("../icons/chevron-right.svg");
    out property <image> add: @image-url("../icons/add.svg");
    out property <image> edit: @image-url("../icons/edit.svg");
    out property <image> copy: @image-url("../icons/copy.svg");
    out property <image> search: @image-url("../icons/search.svg");
    out property <image> today: @image-url("../icons/today.svg");
    out property <image> event: @image-url("../icons/event.svg");
    out property <image> repeat: @image-url("../icons/repeat.svg");
    out property <image> notifications: @image-url("../icons/notifications.svg");
    out property <image> upload: @image-url("../icons/upload.svg");
    out property <image> download: @image-url("../icons/download.svg");
    out property <image> menu: @image-url("../icons/menu.svg");
    out property <image> calendar: @image-url("../icons/calendar.svg");
    out property <image> check-small: @image-url("../icons/check-small.svg");
    out property <image> settings: @image-url("../icons/settings.svg");
    out property <image> info: @image-url("../icons/info.svg");
    out property <image> arrow-back: @image-url("../icons/arrow-back.svg");
}

export component OxideIcon inherits Image {
    in property <length> size: 24px;
    width: self.size;
    height: self.size;
    image-fit: contain;
    colorize: OxideTheme.colors.on-surface;
}
