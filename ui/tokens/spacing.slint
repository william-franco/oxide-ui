// 4dp spacing grid.

export global OxideSpacing {
    out property <length> none: 0px;
    out property <length> xxs: 2px;
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> xl: 24px;
    out property <length> xxl: 32px;
    out property <length> xxxl: 48px;

    // Minimum interactive target (WCAG / M3).
    out property <length> min-target: 48px;
}

// M3 window size classes.
export global OxideBreakpoints {
    out property <length> medium: 600px;
    out property <length> expanded: 840px;
    out property <length> large: 1200px;
}
